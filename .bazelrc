# Use a prebuilt protoc (rules_scala needs one) instead of compiling it from
# source, as SGL itself does. Requires the `protobuf` bazel_dep in MODULE.bazel.
common --incompatible_enable_proto_toolchain_resolution
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc

# Keep a Scala compiler warm between builds.
build --strategy=Scalac=worker
build --worker_sandboxing

# Print the log of failing tests.
test --test_output=errors

# `bazel run //:web` starts SGL's dev server from a path outside its runfiles.
# With a disk or remote cache, Bazel would not download that binary from the
# cache, and the run fails with "server: No such file or directory".
run --remote_download_regex=.*/bazel/scalajs/server_/server$
